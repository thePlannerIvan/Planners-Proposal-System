{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thePlannerIvan/Planners-Proposal-System/contracts/wiki-recipe-catalog.schema.json",
  "title": "跨 Module Recipe 目录",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "catalog_version", "updated_at", "recipes"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "catalog_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "updated_at": {"type": "string", "minLength": 10},
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipe_id", "name", "purpose", "required_lens_ids", "optional_lens_ids", "steps", "use_conditions", "skip_conditions", "source_module_instance_ids"],
        "properties": {
          "recipe_id": {"type": "string", "pattern": "^recipe_[a-z0-9][a-z0-9-]{2,63}$"},
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "required_lens_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "optional_lens_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "steps": {"type": "array", "minItems": 2, "items": {"type": "object"}},
          "use_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "skip_conditions": {"type": "array", "items": {"type": "string"}},
          "source_module_instance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^mi_[a-f0-9]{24}$"}}
        }
      }
    }
  }
}
