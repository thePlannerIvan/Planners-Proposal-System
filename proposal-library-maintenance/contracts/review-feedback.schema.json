{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thePlannerIvan/Planners-Proposal-System/contracts/review-feedback.schema.json",
  "title": "B4 完整人工审阅反馈",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "review_bundle_sha256", "route", "saved_at", "reviewer", "decisions"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "review_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "route": {"enum": ["isolated_bootstrap", "upgrade_existing"]},
    "saved_at": {"type": "string", "minLength": 10},
    "reviewer": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "decision", "target_module_id", "target_id", "edited_proposal", "note_zh"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^review_[a-f0-9]{24}$"},
          "decision": {"enum": ["approve", "revise", "new", "merge", "variant", "revision", "add_source", "reroute", "no_change", "reject", "defer"]},
          "target_module_id": {"type": ["string", "null"]},
          "target_id": {"type": ["string", "null"]},
          "edited_proposal": {"type": ["object", "null"]},
          "note_zh": {"type": "string"}
        }
      }
    }
  }
}
