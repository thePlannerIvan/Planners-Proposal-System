{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thePlannerIvan/Planners-Proposal-System/contracts/page-architecture.schema.json",
  "title": "Storyline 与页面架构交接",
  "description": "记录已经形成的认知推进、章节任务和逐页内容要求；一个 Storyline 节点可以展开为多页。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "project_id", "storyline_thesis", "sections", "pages"],
  "properties": {
    "contract_version": { "const": "2.0.0" },
    "project_id": { "type": "string", "pattern": "^pj_[a-f0-9]{24}$" },
    "storyline_thesis": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "title", "cognitive_job", "transition"],
        "properties": {
          "section_id": { "type": "string", "pattern": "^sec-[a-z0-9][a-z0-9-]{1,47}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "cognitive_job": { "type": "string", "minLength": 1, "maxLength": 800 },
          "transition": { "type": "string", "maxLength": 800 }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_number", "section_id", "page_job", "title_intent", "claim",
          "content_blocks", "evidence_needs", "transition"
        ],
        "properties": {
          "page_number": { "type": "integer", "minimum": 1 },
          "section_id": { "type": "string", "pattern": "^sec-[a-z0-9][a-z0-9-]{1,47}$" },
          "page_job": { "type": "string", "minLength": 1, "maxLength": 800 },
          "title_intent": { "type": "string", "minLength": 1, "maxLength": 300 },
          "claim": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "content_blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["block_title", "role", "content_requirement"],
              "properties": {
                "block_title": { "type": "string", "minLength": 1, "maxLength": 300 },
                "role": { "type": "string", "minLength": 1, "maxLength": 500 },
                "content_requirement": { "type": "string", "minLength": 1, "maxLength": 1500 },
                "suggested_form": {
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "string",
                      "enum": [
                        "paragraph", "list", "table", "chart", "image", "comparison",
                        "matrix", "model", "roadmap", "timeline", "case", "freeform"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "evidence_needs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 800 }
          },
          "chart_brief": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "minLength": 1, "maxLength": 1000 }
            ]
          },
          "layout_direction": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "minLength": 1, "maxLength": 1000 }
            ]
          },
          "transition": { "type": "string", "maxLength": 800 }
        }
      }
    }
  }
}
